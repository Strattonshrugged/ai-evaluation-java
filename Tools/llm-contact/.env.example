# API keys, one per provider. Only the providers you actually target or judge
# with need a key; test-connections skips any left unset. Real environment
# variables take precedence over this file.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
X_API_KEY=xai-...
DEEPSEEK_API_KEY=sk-...

# Default per-call token ceiling for target and judge calls. A test's own
# max_tokens overrides it for that test; --max-tokens overrides it per run.
MAX_TOKENS=1024
